# Linux: X11 based MiniLibX from the .mlx_linux git submodule
# (git clone --recursive, or once: git submodule update --init).
#
# The MLX is built with -std=gnu11 too: compilers that default to C23
# (GCC 15+) reject its old style function declarations.

MLX_PATH			=	.mlx_linux/
MLX					=	$(MLX_PATH)libmlx.a
CFLAGS				+=	-I$(MLX_PATH)
MLX_LDLIBS			=	-L$(MLX_PATH) -lmlx -lX11 -lXext
SRCS_PLATFORM		=	utils/platform_linux.c

$(MLX):
	@test -f $(MLX_PATH)Makefile || { echo "$(MLX_PATH) is empty, run:" \
		"git submodule update --init"; exit 1; }
	$(MAKE) -C $(MLX_PATH) CC="cc -std=gnu11"

mlx_clean:
	@if [ -f $(MLX_PATH)Makefile ]; then $(MAKE) -C $(MLX_PATH) clean; fi

mlx_fclean: mlx_clean
