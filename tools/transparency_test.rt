# Transparency Test Scene
# tr=<0..1>  how much light passes through (1 = fully clear)
# ior=<n>    index of refraction (default 1.5, glass)

# Ambient light
A 0.2 255,255,255

# Camera: Positioned back and slightly up
C 0,5,20 0,-0.1,-1 70

# Light: Top right
L 15,20,15 0.8 255,255,255

# Floor: Grey/Dark Grey Checkerboard
# This helps visualize the refraction distortion
pl 0,-5,0 0,1,0 150,150,150 r=0.0 ch=50,50,50

# Center: Clear Glass Sphere, slightly reflective
sp 0,0,0 10 255,255,255 r=0.3 tr=0.6

# Left: Red Tinted Glass Sphere
# Lower transparency shows more of the object's color
sp -12,0,5 8 255,0,0 r=0.1 tr=0.6

# Right: Opaque Blue Mirror Sphere (for contrast)
sp 12,0,5 8 50,50,255 r=0.7

# Back: Green Semi-Transparent Cylinder
cy 0,0,-15 1,0,0 4 15 0,255,0 r=0.2 tr=0.5

cy 0,13,35 1,0,0 4 15 0,255,0 r=0.3 tr=0.8 ior=1.33
