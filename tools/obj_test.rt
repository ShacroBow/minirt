# Wavefront .obj models
# obj <file.obj> <center x,y,z> <size> <R,G,B> [rot=x,y,z] [r= ch= tx= bump= u= v= tr= ior=]
#   size  length of the model's longest side in the scene
#   color multiplies the colors of the model's .mtl materials (use white to keep them)
#   rot   rotation in degrees around x, then y, then z
# Select a model with 3, move it with WASD / PG UP / PG DOWN,
# scale it with UP / DOWN and turn it with LEFT / RIGHT.

A 0.2 255,255,255
C 0,1.7,6.3 0,-0.25,-1 60
L -4,7,6 0.45 255,255,255
L 5,5,4 0.25 255,240,220

pl 0,-1,0 0,1,0 190,190,190 ch=110,110,110 r=0.1

# material per face (.mtl), textured (map_Kd), generated normals, glass (.mtl)
obj tools/models/cube_colors.obj -2.6,-0.3,0.4 1.4 255,255,255 rot=0,35,0
obj tools/models/crate.obj 2.6,-0.3,0.4 1.4 255,255,255 rot=0,-25,0
obj tools/models/torus_knot.obj 0,0.9,-2.2 3.4 220,80,55 r=0.25 rot=10,0,0
obj tools/models/glass_drop.obj 0,-0.2,1.3 1.6 255,255,255
