# miniRT car studio: a concept car on a turntable under hexagon lights.
# Leave it still for a minute and it refines itself.
# Shows: .obj + .mtl (clear coat paint, chrome, glass, textures, glowing
# lights), glowing objects (em=), mirrors, glass balls, checkerboard,
# texture + bump map, colored soft shadows. Car: CC BY 4.0, see
# tools/models/CREDITS.md

A 0.12 180,190,255
C 0,1.3,8.8 0,-0.03,-0.9995 40

# cool key under the hex lights, front fill, warm studio lamp,
# cyan and violet uplights washing the wall
L 0.6,4,0.6 1 240,245,255
L 0.5,2.6,8 0.55 255,250,245
L 3.06,1.87,-1.98 0.4 255,190,120
L -4,0.35,-6.65 1 80,190,255
L 4,0.35,-6.65 1 190,110,255

# polished tiled floor, concrete panel wall with a bump map, dark room
pl 0,0,0 0,1,0 16,16,18 ch=24,24,28 r=0.15
pl 0,0,-7 0,0,1 255,255,255 tx=tools/concrete_wall.ppm bump=tools/concrete_wall.bump.ppm u=0.18 v=0.18
pl 0,7,0 0,-1,0 10,10,12
pl -13,0,0 1,0,0 14,14,16
pl 13,0,0 -1,0,0 14,14,16
pl 0,0,22 0,0,-1 14,14,16

# turntable with a glowing edge
cy 0,0.08,0 0,1,0 8 0.16 18,18,21 r=0.3
cy 0,0.03,0 0,1,0 8.2 0.06 90,200,255 em=2

# the car (.obj + .mtl: paint, chrome, glass, textures, glowing lights)
obj tools/models/car/concept_car.obj 0,0.82,0 5 255,255,255 rot=0,-40,0

# glowing hexagon grid above, LED tubes and uplights by the wall
obj tools/models/hex_lights.obj 0,4.6,0 8.2 230,240,255 em=1.5
cy -6.2,2.75,-6.3 0,1,0 0.14 5.5 90,200,255 em=2
cy 6.2,2.75,-6.3 0,1,0 0.14 5.5 200,120,255 em=2
cy -4,0.05,-6.7 0,1,0 0.5 0.1 90,200,255 em=2
cy 4,0.05,-6.7 0,1,0 0.5 0.1 200,120,255 em=2

# studio lamp: base, stand, aluminium cone shade, glowing lens
cy 3.75,0.02,-2.45 0,1,0 0.6 0.04 25,25,28
cy 3.75,1,-2.45 0,1,0 0.06 2 25,25,28
co 3.7,2.1,-2.4 0.805,0.283,-0.522 0.7 0.8 110,110,116 r=0.35
cy 3.36,1.98,-2.18 0.805,0.283,-0.522 0.64 0.04 255,215,160 em=2.5

