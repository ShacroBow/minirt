# macOS: Metal based MiniLibX, built from source in .mlx_macos.
#
# The dylib's install name is changed to @rpath/libmlx.dylib and the binary
# gets an rpath pointing at .mlx_macos, so ./minirt runs from any directory
# without copying the library around or setting DYLD_LIBRARY_PATH.

MLX_PATH			=	.mlx_macos/
MLX					=	$(MLX_PATH)libmlx.dylib
CFLAGS				+=	-I$(MLX_PATH)
MLX_LDLIBS			=	-L$(MLX_PATH) -lmlx -Wl,-rpath,@executable_path/$(MLX_PATH)
SRCS_PLATFORM		=	utils/platform_macos.c

# -j1: the MLX Makefile does not declare the order its Swift modules
# import each other in, so it only builds serially.
$(MLX):
	$(MAKE) -C $(MLX_PATH) -j1
	install_name_tool -id @rpath/libmlx.dylib $(MLX)
	codesign --force --sign - $(MLX)

mlx_clean:
	$(MAKE) -C $(MLX_PATH) clean
	rm -f $(MLX_PATH)*.swiftsourceinfo $(MLX_PATH)*.abi.json

mlx_fclean: mlx_clean
